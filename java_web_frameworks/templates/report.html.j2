<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Java Web Frameworks · Benchmark Report</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<style>
  :root {
    --bg: #0d1117;
    --bg-elev: #161b22;
    --bg-card: #1c2129;
    --border: #30363d;
    --fg: #e6edf3;
    --fg-muted: #8b949e;
    --accent: #58a6ff;
    --accent-2: #d2a8ff;
    --good: #3fb950;
    --warn: #f0b72f;
    --bad: #f85149;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f6f8fa;
      --bg-elev: #ffffff;
      --bg-card: #ffffff;
      --border: #d0d7de;
      --fg: #1f2328;
      --fg-muted: #57606a;
      --accent: #0969da;
      --accent-2: #8250df;
      --good: #1a7f37;
      --warn: #9a6700;
      --bad: #cf222e;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter",
                 Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--fg);
    line-height: 1.5;
  }
  header.hero {
    background: linear-gradient(135deg, #1f6feb 0%, #8250df 100%);
    color: #fff;
    padding: 4rem 1.5rem 3rem;
    text-align: center;
  }
  header.hero h1 { margin: 0 0 .5rem; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  header.hero p { margin: .25rem 0; opacity: .92; }
  main { max-width: 1200px; margin: -1.5rem auto 3rem; padding: 0 1.25rem; }
  section.card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,.08);
  }
  h2 { margin-top: 0; font-size: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: .5rem; }
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
  }
  .chart-card { background: var(--bg-elev); border: 1px solid var(--border); border-radius: 10px; padding: 1rem; }
  .chart-card header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .5rem; }
  .chart-card h3 { margin: 0; font-size: 1rem; }
  .chart-card .hint { font-size: .8rem; color: var(--fg-muted); }
  .chart-wrap { position: relative; height: 260px; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: .9rem; }
  th, td { padding: .55rem .75rem; text-align: right; border-bottom: 1px solid var(--border); }
  th:first-child, td:first-child { text-align: left; position: sticky; left: 0; background: var(--bg-card); }
  th { color: var(--fg-muted); font-weight: 600; cursor: pointer; user-select: none; white-space: nowrap; }
  th:hover { color: var(--accent); }
  tr:hover td { background: rgba(88,166,255,.06); }
  td.winner { color: var(--good); font-weight: 700; }
  .badge { display: inline-block; font-size: .7rem; padding: 2px 8px; border-radius: 999px; background: rgba(88,166,255,.15); color: var(--accent); }
  .badge.native { background: rgba(63,185,80,.15); color: var(--good); }
  footer { text-align: center; color: var(--fg-muted); font-size: .85rem; padding: 1.5rem; }
  footer a { color: var(--accent); text-decoration: none; }
</style>
</head>
<body>
<header class="hero">
  <h1>Java Web Frameworks Benchmark</h1>
  <p>Spring Boot · Quarkus · Micronaut · Helidon — JVM &amp; native</p>
  <p style="font-size:.85rem;opacity:.8">Generated {{ generated_at }}</p>
</header>

<main>
  <section class="card">
    <h2>Summary</h2>
    <div class="table-wrap">
      <table id="summary-table">
        <thead>
          <tr>
            <th>Project</th>
            <th>Build (ms)</th>
            <th>Memory (MB)</th>
            <th>JVM start (ms)</th>
            <th>FW start (ms)</th>
            <th>FW stop (ms)</th>
            <th>Total (ms)</th>
            <th>Image (MB)</th>
            <th>Efficiency</th>
          </tr>
        </thead>
        <tbody>
        {% for row in rows %}
          <tr>
            <td>
              {{ row.framework }}
              <span class="badge {% if row.build_type == 'native' %}native{% endif %}">{{ row.build_type }}</span>
            </td>
            <td>{{ row.build_duration }}</td>
            <td>{{ row.memory_used_mb }}</td>
            <td>{{ row.java_start_ms }}</td>
            <td>{{ row.framework_start_ms }}</td>
            <td>{{ row.framework_stop_ms }}</td>
            <td>{{ row.total_runtime_ms }}</td>
            <td>{{ row.image_size_mb }}</td>
            <td>{{ "%.2f"|format(row.efficiency_pct) }}%</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2>Charts</h2>
    <div class="grid">
    {% for chart in charts %}
      <div class="chart-card">
        <header>
          <h3>{{ chart.label }} ({{ chart.unit }})</h3>
          <span class="hint">{{ "lower is better" if chart.lower_is_better else "higher is better" }}</span>
        </header>
        <div class="chart-wrap"><canvas id="chart-{{ chart.key }}"></canvas></div>
      </div>
    {% endfor %}
    </div>
  </section>
</main>

<footer>
  <p>
    Source: <a href="https://github.com/tyutyutyu/java-web-frameworks">tyutyutyu/java-web-frameworks</a>
  </p>
</footer>

<script>
const charts = {{ charts | tojson }};
const css = getComputedStyle(document.documentElement);
const fg = css.getPropertyValue('--fg').trim();
const muted = css.getPropertyValue('--fg-muted').trim();
const grid = css.getPropertyValue('--border').trim();
const accent = css.getPropertyValue('--accent').trim();
const good = css.getPropertyValue('--good').trim();

Chart.defaults.color = fg;
Chart.defaults.borderColor = grid;

for (const c of charts) {
  const ctx = document.getElementById('chart-' + c.key);
  const colors = c.values.map(v => v === c.winner ? good : accent);
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: c.labels,
      datasets: [{
        label: c.label + ' (' + c.unit + ')',
        data: c.values,
        backgroundColor: colors,
        borderRadius: 6,
      }],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: 'y',
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: muted }, grid: { color: grid } },
        y: { ticks: { color: fg }, grid: { display: false } },
      },
    },
  });
}

// Highlight per-column winners in the summary table.
(function highlightWinners() {
  const table = document.getElementById('summary-table');
  const rows = [...table.tBodies[0].rows];
  const colCount = rows[0]?.cells.length ?? 0;
  // Column index -> lower-is-better. Index 0 is project name.
  const lowerIsBetter = [null, true, true, true, true, true, true, true, false];
  for (let col = 1; col < colCount; col++) {
    const values = rows.map(r => parseFloat(r.cells[col].textContent.replace('%','')));
    const target = lowerIsBetter[col] ? Math.min(...values) : Math.max(...values);
    rows.forEach((r, i) => { if (values[i] === target) r.cells[col].classList.add('winner'); });
  }
})();
</script>
</body>
</html>
